# Application
NODE_ENV=development
PORT=5000
COMPANY_NAME="Building Management System"

# MongoDB / Prisma
# MongoDB transactions require a replica set, including for local development.
DATABASE_URL="mongodb://localhost:27017/building-management-system?replicaSet=rs0"

# Public application URLs
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"
BACKEND_UPLOADS_URL="http://localhost:5000/uploads"
BACKEND_STREAM_URL="http://localhost:5000"
RESET_PASS_URL="http://localhost:3000/reset-password"
PAYMENT_SUCCESS_URL="http://localhost:3000/payment/success"
PAYMENT_FAILED_URL="http://localhost:3000/payment/failed"

# Email: configure the provider used by src/core/services/email.
# SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER="" # Gmail Address for Gmail | User for others
SMTP_PASS="" # App password for Gmail | Password for other SMTP providers
SENDER_EMAIL=""

# SendGrid
SENDGRID_API_KEY=""
SENDGRID_EMAIL=""

# Resend
RESEND_API_KEY=""
RESEND_EMAIL=""

# Brevo
BREVO_API_KEY=""
BREVO_EMAIL=""

# Authentication and password hashing
JWT_SECRET="replace-with-a-long-random-secret"
JWT_SECRET_EXPIRES_IN=604800 # seconds; 7 days

REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret"
REFRESH_TOKEN_EXPIRES_IN=2592000 # seconds; 30 days

RESET_TOKEN_SECRET="replace-with-a-reset-token-secret"
RESET_TOKEN_EXPIRES_IN=900 # seconds; 15 minutes
PASSWORD_SALT=12

# Initial Admin seed account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Stripe integration (optional for internal payment bookkeeping)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_CLIENT_ID=""

# PayPal integration settings (optional)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE=sandbox

# AWS-compatible object storage settings (optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_BUCKET_NAME=""